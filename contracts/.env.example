# ── Deploy wallet ──────────────────────────────────────────────────────────
# Same wallet as backend/.env PRIVATE_KEY — this address becomes `owner` on
# all 3 contracts. NEVER commit this value. Use a dedicated testnet-only wallet.
PRIVATE_KEY=

# ── RPC ────────────────────────────────────────────────────────────────────
MONAD_RPC_URL=https://testnet-rpc.monad.xyz

# ── Agent identity hashes ────────────────────────────────────────────────────
# Output of `python3 backend/blockchain/hashing_utils.py` — paste the 4 lines
# it prints here before running the deploy script. If left unset, the deploy
# script falls back to a deterministic PLACEHOLDER hash for each agent, which
# means AgentIdentityRegistry verification is checking a fake fingerprint,
# not your real running agents.
RESEARCHER_HASH=
VALIDATOR_HASH=
SCORER_HASH=
REPORTER_HASH=
