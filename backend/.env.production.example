# Template for backend/.env.production — read by docker-compose.production.yml
# (never docker-compose.yml, which reads backend/.env instead; keeping the
# two files separate means a real production secret is never sitting in the
# same file a developer might casually cat/grep during local dev).
#
# Copy this to backend/.env.production and fill in every value. Nothing here
# has a usable default the way backend/.env.example's dev values do —
# docker-compose.production.yml's `${VAR:?...}` guards make `docker compose`
# itself refuse to start if a required one is still empty, so there's no
# "forgot to set it, silently got the dev password" failure mode.

# ── Database ───────────────────────────────────────────────────────────────
# Real, generated passwords — NOT the checked-in "trustchain"/
# "trustchain_api_dev_password" values docker-compose.yml uses for local dev.
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_SUPERUSER_PASSWORD=
POSTGRES_API_PASSWORD=

# ── Auth ───────────────────────────────────────────────────────────────────
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=

# ── Browser session cookies (P1: cookie-based auth) ───────────────────────────
# COOKIE_SECURE/COOKIE_SAMESITE default correctly (true/lax) — only set
# COOKIE_DOMAIN, and only if the frontend is deployed on a DIFFERENT
# subdomain of the same registrable domain this API is on (e.g. frontend on
# app.example.com, API on api.example.com — set COOKIE_DOMAIN=.example.com).
# Leave empty for a single-domain deployment. See config.py's own comments
# for the full reasoning, including why a genuinely cross-site deployment
# (no shared parent domain) needs a same-origin BFF/proxy in the frontend
# app instead of loosening these.
COOKIE_DOMAIN=

# ── Blockchain ─────────────────────────────────────────────────────────────
# The real chain you're anchoring to — never Anvil. docker-compose.production.yml
# has no anvil service at all (see that file's own comment on why).
MONAD_RPC_URL=
V2_RPC_URL=
# Only needed if SIGNER_BACKEND=local below (dev/small-deployment only — see
# SIGNER_BACKEND's own comment). A real production deployment should prefer
# aws_kms/gcp_kms/vault_kv so the raw key never lives in this file at all.
PRIVATE_KEY=""
# Falls back to PRIVATE_KEY above when unset (config.py's resolved_v2_private_key).
V2_PRIVATE_KEY=""

SIGNER_BACKEND=local
KMS_KEY_ID=
KMS_REGION=
VAULT_ADDR=
VAULT_TOKEN=
VAULT_SECRET_PATH=
VAULT_MOUNT_POINT=secret
VAULT_KEY_FIELD=private_key

# ── LLM / search ───────────────────────────────────────────────────────────
GROQ_API_KEY=
TAVILY_API_KEY=

# ── Reverse proxy / TLS (deploy/production/Caddyfile) ─────────────────────
# The public domain Caddy requests/renews a TLS cert for. Required — Caddy's
# config reads this via {$DOMAIN}.
DOMAIN=

# ── Metrics (optional second layer, see config.py's metrics_auth_token) ────
# Leave empty to rely solely on network isolation (docker-compose.production.yml
# publishes no worker-metrics ports, and Caddy never proxies /metrics
# publicly — see deploy/production/Caddyfile). Set this to also require a
# matching X-Metrics-Token header on GET /metrics.
METRICS_AUTH_TOKEN=

# ── Email (alerts, invitations) ─────────────────────────────────────────────
EMAIL_BACKEND=console
EMAIL_FROM=
BREVO_API_KEY=
BREVO_API_URL=https://api.brevo.com/v3/smtp/email
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true

# ── Observability (optional) ────────────────────────────────────────────────
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
GRAFANA_CLOUD_PROMETHEUS_URL=
GRAFANA_CLOUD_PROMETHEUS_USER=
GRAFANA_CLOUD_PROMETHEUS_API_KEY=
GRAFANA_CLOUD_LOKI_URL=
GRAFANA_CLOUD_LOKI_USER=
GRAFANA_CLOUD_LOKI_API_KEY=

# ── Evidence publishing (optional — see evidence/backends/) ────────────────
# Leave disabled if you don't have a Pinata account; anchoring itself is
# entirely unaffected either way.
EVIDENCE_PUBLISHER_BACKEND=disabled
PINATA_JWT=

ENVIRONMENT=production
