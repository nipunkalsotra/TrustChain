# ── LLM ──────────────────────────────────────────────────────────────────────
# Groq API key — powers all 4 agents (llama-3.3-70b-versatile)
# Get one at https://console.groq.com/keys
GROQ_API_KEY=

# ── Web search / fact-checking (used by mcp_servers/web_search, but the ──────
# backend also needs it exported so start.sh / shared .env workflows work)
# Get one at https://tavily.com
TAVILY_API_KEY=

# ── Blockchain (Monad testnet) ────────────────────────────────────────────────
MONAD_RPC_URL=https://testnet-rpc.monad.xyz
# Optional, comma-separated: additional RPC endpoints tried in order if the
# primary's circuit breaker trips (repeated failures) — see
# blockchain/resilient_provider.py. Leave empty for single-endpoint
# behavior (today's default, unchanged). V2_RPC_FALLBACK_URLS is the same
# idea for the anchor worker/indexer's V2 connection.
MONAD_RPC_FALLBACK_URLS=
V2_RPC_FALLBACK_URLS=

# Deployer/backend wallet private key — this wallet owns all 3 contracts and
# pays gas for every logAction/updateScore/registerAgent call.
# NEVER commit this value. Use a dedicated testnet-only wallet.
PRIVATE_KEY=

# Optional — separate signing key for V2 (score_writer.py/identity_writer.py,
# anchor_worker, indexer). Falls back to PRIVATE_KEY above when unset
# (config.py's resolved_v2_private_key) — for local dev against Anvil, one
# key for both is normal and matches CLAUDE.md's local-deploy drill (Anvil's
# well-known default account #0, the one DeployV2.s.sol grants ANCHOR_ROLE
# to). Only set this to something different for a real deployment where V1
# and V2 are meant to be operated by distinct wallets.
V2_PRIVATE_KEY=

# ── Auth ───────────────────────────────────────────────────────────────────
# Signs session JWTs issued by POST /auth/login and /auth/signup.
# REQUIRED — the backend now fails to start if this is unset, rather than
# falling back to a random per-process secret (that fallback used to
# invalidate every session on restart and differ across replicas).
# Generate one with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=

# ── Database ─────────────────────────────────────────────────────────────────
# Async SQLAlchemy DSN — must use the asyncpg driver. The docker-compose.yml
# at the repo root starts a matching local Postgres on this exact URL.
#
# This is the `trustchain` SUPERUSER role — right for running pytest/alembic
# directly against a local Postgres, since migrations need owner privileges
# and most tests intentionally bypass Row-Level Security to set up
# cross-tenant fixtures (see tests/test_row_level_security.py, which
# exercises RLS itself via its own dedicated connection). The docker-compose
# `api` service instead connects as the more-restricted `trustchain_api`
# role that RLS actually binds to — see docker-compose.yml and
# alembic/versions/9f3a1c7d5e2b_row_level_security_for_tenant_tables.py.
DATABASE_URL=postgresql+asyncpg://trustchain:trustchain@localhost:5432/trustchain

# ── Redis (SSE event bus, rate limiting, idempotency) ─────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Signing backend (P2.5) ─────────────────────────────────────────────────────
# "local" (default) uses PRIVATE_KEY/V2_PRIVATE_KEY above directly.
# "aws_kms" / "gcp_kms" keep the anchor worker's key inside a cloud KMS —
# see blockchain/signer.py and docs/multisig-admin-handoff.md.
# "vault_kv" fetches the key from HashiCorp Vault's KV v2 engine at startup
# instead of a plaintext value here — see VaultKvSigner's docstring for why
# that's Vault-backed key custody, not Vault-backed signing (Vault OSS's
# Transit engine doesn't support secp256k1).
SIGNER_BACKEND=local
KMS_KEY_ID=
KMS_REGION=
VAULT_ADDR=
VAULT_TOKEN=
VAULT_SECRET_PATH=
VAULT_MOUNT_POINT=secret
VAULT_KEY_FIELD=private_key

# ── Observability (P2.6) ────────────────────────────────────────────────────
# Empty disables each of these — no behavior change, no network calls.
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
# Ports the anchor worker / indexer expose their own Prometheus /metrics
# on (the API exposes its at GET /metrics on its normal port instead).
ANCHOR_WORKER_METRICS_PORT=9101
INDEXER_METRICS_PORT=9102

# ── Integrity watchdog + alert email delivery (Phase 3) ───────────────────────
# integrity_watchdog/main.py detects on-chain/DB drift (e.g. a directly-
# tampered `steps` row) and raises alerts; notifications/sender.py drains
# them as emails. See docs/adr/0020-database-audit-logging-and-attribution.md
# for what's captured (who/what changed) alongside each alert.
WATCHDOG_ENABLED=true
WATCHDOG_METRICS_PORT=9103

# "console" (default) just logs the email instead of sending — right for
# local dev / CI with no real mail credentials configured. "smtp" sends via
# a real SMTP relay (SMTP_* below); "brevo" sends via Brevo's transactional
# email REST API instead of SMTP (notifications/backends/brevo.py) — useful
# when SMTP port 587 is unreliable from your network, which is what this
# repo actually hit — see git history around the brevo.py backend for the
# real failure mode (port 587 blocked, unrelated to credentials).
EMAIL_BACKEND=console
# Must be a sender identity verified with whichever provider you use (Brevo
# rejects unverified senders outright) — see your provider's sender-identity
# settings, not just a value you pick.
EMAIL_FROM=alerts@trustchain.local

# Used when EMAIL_BACKEND=smtp.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true

# Used when EMAIL_BACKEND=brevo. Get a REST API key (starts xkeysib-, NOT
# the xsmtpsib- SMTP relay password — different products, not
# interchangeable) at https://app.brevo.com/settings/keys/api. Also check
# https://app.brevo.com/security/authorised_ips — Brevo can reject sends
# from an unrecognized IP depending on account settings.
BREVO_API_KEY=
BREVO_API_URL=https://api.brevo.com/v3/smtp/email

# How often the same alert can re-notify (throttle) vs. how often a
# lower-priority digest of everything open goes out regardless.
ALERT_EMAIL_ENABLED=true
ALERT_EMAIL_THROTTLE_SECONDS=21600
ALERT_DIGEST_INTERVAL_SECONDS=86400
ALERT_DELIVERY_MAX_ATTEMPTS=5

# ── Grafana Cloud (docker-compose.yml's `alloy` service, --profile ───────────
# observability) — only needed if you're opting into observability
# locally. Leave empty otherwise; docker/alloy/config.alloy just won't
# have anything to authenticate with and the alloy container will fail
# to push (it still starts either way, no crash-loop).
# Get these from your Grafana Cloud account: grafana.com -> My Account ->
# your stack -> Details, for the two URLs/usernames; Access Policies ->
# Create access policy (scopes metrics:write / logs:write) -> Add token,
# for the two API keys below. Use two separately-scoped tokens, not one
# shared one — that's what Grafana Cloud's own onboarding generates by
# default, and there's no reason to widen it.
GRAFANA_CLOUD_PROMETHEUS_URL=
GRAFANA_CLOUD_PROMETHEUS_USER=
GRAFANA_CLOUD_PROMETHEUS_API_KEY=
GRAFANA_CLOUD_LOKI_URL=
GRAFANA_CLOUD_LOKI_USER=
GRAFANA_CLOUD_LOKI_API_KEY=
