# ── LLM ──────────────────────────────────────────────────────────────────────
# Groq API key — powers all 4 agents (llama-3.3-70b-versatile)
# Get one at https://console.groq.com/keys
GROQ_API_KEY=

# ── Web search / fact-checking (used by mcp_servers/web_search, but the ──────
# backend also needs it exported so start.sh / shared .env workflows work)
# Get one at https://tavily.com
TAVILY_API_KEY=

# ── Blockchain (Monad testnet) ────────────────────────────────────────────────
MONAD_RPC_URL=https://testnet-rpc.monad.xyz

# Deployer/backend wallet private key — this wallet owns all 3 contracts and
# pays gas for every logAction/updateScore/registerAgent call.
# NEVER commit this value. Use a dedicated testnet-only wallet.
PRIVATE_KEY=

# ── Auth ───────────────────────────────────────────────────────────────────
# Signs session JWTs issued by POST /auth/login and /auth/signup.
# If unset, a random secret is generated per-process (fine for solo local dev
# only — every restart invalidates existing sessions). Generate one with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
